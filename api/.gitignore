# Virtual environment managed by uv — never commit
.venv/

# Build output
dist/

# Python bytecode caches
__pycache__/
*.py[cod]
*.pyo

# Coverage
.coverage
coverage.xml
htmlcov/

# pytest cache
.pytest_cache/

# Ruff cache
.ruff_cache/

# Basedpyright (only if auto-generated; commit if manually configured)
pyrightconfig.json

# Environment variables — never commit plaintext secrets
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# devenv / Nix — generated caches; never commit.
# devenv.lock and devenv.yaml MUST be committed.
.devenv/
.devenv.flake.nix
.pre-commit-config.yaml
